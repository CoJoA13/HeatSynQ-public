DATABASE_URL="postgresql://erp:erp_local_dev@localhost:5432/erp"
DATABASE_URL_TEST="postgresql://erp:erp_local_dev@localhost:5432/erp_test"
SESSION_SECRET="dev-change-me-32-chars-minimum!!"

# Phase 8B: the practice copy (a separate DB + app on port 8080, started with
# `docker compose --profile practice up`). For a LOCAL (non-docker) practice run, point the app at
# erp_practice and set PRACTICE_MODE — but db-identity is authoritative, so a mis-set flag on a
# prod-pointed app is refused, never honored.
DATABASE_URL_PRACTICE="postgresql://erp:erp_local_dev@localhost:5432/erp_practice"
PRACTICE_MODE="false"

# Phase 8C: the folder the nightly backup container writes to and the app lists / backs up into.
# A DEPLOY value shared by both writers, not a runtime setting. In docker compose this is the
# container path /backups (host side: the ./backups bind-mount). For a LOCAL dev run, point it at a
# real folder you have created — /backups does not exist on a dev host:
#   mkdir -p backups
BACKUP_DIR="./backups"

# Release updates: the folder the host's release agent writes status.json into and the app writes
# hold.json into (compose mounts ./updates at /updates). Unset means this install has no update
# information and the Updates screens stay empty.
# UPDATES_DIR="./updates"

# #588: the office share a finalized invoice or credit print is copied into, in the folder the
# customer page's Invoice folder box names. Both empty = off: prints file nothing, and the box
# refuses any folder. DEPLOY values, never a screen setting, and never on the practice copy. In
# docker compose this file does not reach the app container: set both under services.app in the
# install's untracked docker-compose.override.yml (README, "Customer folders").
#   OFFICE_SHARE_DIR   the share's mount path inside the container; the marker file
#                      "HeatSynQ - do not delete.txt" sits at its top.
#   OFFICE_SHARE_ROOT  the same folder as the office's PCs show it: a mapped drive root such as Z:\,
#                      or a \\server\share path.
# Write the root SINGLE-quoted. Inside double quotes "\n" and "\r" become line breaks
# ("\\server\new" arrives holding one), and the app refuses the value as misconfigured. For a LOCAL
# run: a folder you created, holding the marker file, and a root such as 'Z:\'. The tests ignore
# both (tests/helpers/setup.ts).
OFFICE_SHARE_DIR=""
OFFICE_SHARE_ROOT=""

# Optional read-only operations probe. Empty disables /api/health/operations (404).
# Generate a distinct random 32-byte hex token; do not reuse SESSION_SECRET.
# See ../ops/monitoring/README.md. Never place the token in a URL or Git.
HEALTH_MONITOR_TOKEN=""

# Optional read-only LoadSynQ recipe API. Empty disables it (404).
# Use a separately provisioned random 32-byte hex token, never HEALTH_MONITOR_TOKEN.
LOADSYNQ_API_TOKEN=""
