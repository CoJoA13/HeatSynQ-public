{
  "name": "erp",
  "version": "0.1.0-rc.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/public-runtime/public-command.mjs dev",
    "build": "npm run public:prepare && next build",
    "start": "node scripts/public-runtime/public-command.mjs start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --test --test-timeout=15000 e2e/manual-backup-folder.test.mjs && node e2e/run.mjs",
    "test:e2e:dev": "E2E_SERVER=dev npm run test:e2e",
    "manual:capture": "node e2e/manual-capture.mjs",
    "manual:build": "node scripts/build-manual.mjs",
    "db:migrate": "node scripts/public-runtime/public-command.mjs migrate",
    "db:deploy": "node scripts/public-runtime/public-command.mjs deploy",
    "db:bootstrap": "node scripts/public-runtime/public-bootstrap.mjs",
    "db:reset": "node scripts/public-runtime/public-command.mjs reset",
    "db:seed": "node scripts/public-runtime/public-command.mjs seed",
    "db:seed:demo": "node scripts/public-runtime/public-command.mjs demo",
    "public:prepare": "node scripts/build-public-runtime.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "bwip-js": "^4.11.4",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.13",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "playwright": "1.65.1",
    "read-excel-file": "^9.3.20",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    },
    "@prisma/config@7.10.1": {
      "effect": "3.22.5"
    },
    "prisma@7.10.0": {
      "mysql2": "3.24.4"
    },
    "postcss": "^8.5.28",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "argon2@0.45.2": true
  },
  "license": "Apache-2.0"
}
